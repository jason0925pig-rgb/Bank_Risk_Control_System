# Live LLM mode only — the deterministic engine and web demo need no keys.
# Copy to .env and fill in. NEVER commit a real .env.

# LLM access via OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: full-call observability in the Langfuse dashboard
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# One model per agent tier (any OpenRouter model id)
TRIAGE_MODEL=google/gemini-2.0-flash-lite-001
ANALYSIS_MODEL=google/gemini-2.0-flash-001
JUDGE_MODEL=anthropic/claude-3.5-sonnet
